; Bahram CM — PHP-FPM pool overrides
; Applied by deploy/scripts/deploy.sh onto /etc/php/8.4/fpm/pool.d/www.conf
;
; Sized for ~8GB RAM / 6-core shared box (Nginx + PHP-FPM + Next/PM2 + MySQL + Redis).
; Leave headroom: MySQL ~2GB + Redis ~0.5–1GB + Next ~1GB + OS.
; pm.max_children ≈ remaining / ~50MB per worker → ~40–48

pm = dynamic
pm.max_children = 48
pm.start_servers = 6
pm.min_spare_servers = 3
pm.max_spare_servers = 12
pm.max_requests = 500

; Slow request logging
request_slowlog_timeout = 5s
slowlog = /var/log/php8.4-fpm-slow.log

; OPcache (also set in php.ini for production)
; opcache.enable=1
; opcache.memory_consumption=256
; opcache.max_accelerated_files=20000
; opcache.validate_timestamps=0
; opcache.revalidate_freq=0
